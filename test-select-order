#!/usr/bin/env bash
set -u
HERE="$(cd "$(dirname "$0")" && pwd)"
SELECT="$HERE/select-order"
fail=0

check() {
  local desc="$1" got="$2" want="$3"
  if [ "$got" != "$want" ]; then
    echo "FAIL: $desc"
    echo "  got:  [$got]"
    echo "  want: [$want]"
    fail=1
  else
    echo "ok: $desc"
  fi
}

# join lines with commas for comparison
run() { bash "$SELECT" "$1" "$2" | paste -sd, -; }

check "single provider"            "$(run 'cloudrun' 0)"            "cloudrun"
check "rotate start 0"             "$(run 'cloudrun,fly,railway' 0)" "cloudrun,fly,railway"
check "rotate start 1"             "$(run 'cloudrun,fly,railway' 1)" "fly,railway,cloudrun"
check "rotate wraps"               "$(run 'cloudrun,fly,railway' 4)" "fly,railway,cloudrun"
check "trims whitespace"           "$(run ' cloudrun , fly ' 0)"     "cloudrun,fly"
check "drops empty entries"        "$(run 'cloudrun,,fly' 0)"        "cloudrun,fly"
check "empty list prints nothing"  "$(run '' 3)"                     ""

exit $fail
